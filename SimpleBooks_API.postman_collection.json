				{
					"name": "Get All Books",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let books = pm.response.json();         // Puri books ki list le lo\r",
									"\r",
									"let totalBooks = books.length;          // Count kitni books hain\r",
									"\r",
									"let randomIndex = Math.floor(Math.random() * totalBooks);   // 0 se le kar total tak koi bhi index\r",
									"\r",
									"let bookId = books[randomIndex].id;         // Random book ka ID uthao\r",
									"\r",
									"\r",
									"pm.collectionVariables.set(\"bookId\", bookId);  // Usko bookId variable mein save karo\r",
									"\r",
									"\r",
									"let book = books[randomIndex];\r",
									"pm.collectionVariables.set(\"bookName\", book.name);\r",
									"pm.collectionVariables.set(\"bookAuthor\", book.author);\r",
									"pm.collectionVariables.set(\"bookType\", book.type);\r",
									"pm.collectionVariables.set(\"bookAvailable\", book.available);\r",
									"\r",
									"\r",
									"\r",
									"//Tests\r",
									"pm.test(\"Status code is 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
